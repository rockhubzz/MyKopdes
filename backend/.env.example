APP_NAME="Koperasi Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# These bootstrap the container connection. Once the app is running, admins
# can change effective DB host/port/API base URL at runtime from
# Admin > Settings > Infrastructure without redeploying — see
# app/Services/SettingsService.php. These env values remain the fallback
# used before the settings table has been seeded, and by `php artisan`
# commands that run outside the request lifecycle (migrations, queue workers).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=koperasi
DB_USERNAME=koperasi
DB_PASSWORD=koperasi_secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
SANCTUM_TOKEN_EXPIRATION_MINUTES=720
FRONTEND_URL=http://localhost

# Runtime-editable defaults (seeded into the `settings` table on first run;
# afterwards the DB row wins, not this file). See SettingsService::get().
DEFAULT_TAX_RATE=0
DEFAULT_SHU_RATE=0.02
LOW_STOCK_DEFAULT_THRESHOLD=10

BACKUP_DISK=local
BACKUP_SCHEDULE_CRON="0 2 * * *"

MAIL_MAILER=log
