# Keep images reproducible and secret-free: dependency dirs, local env files,
# and Laravel runtime artifacts are (re)created inside the image or at
# container startup — never baked in from the build context.
# (`/*` + `!.gitkeep` keeps the directories themselves so Laravel always has
# somewhere to write compiled views, sessions, and cache files.)
.git
vendor
node_modules
.env
.env.backup
.env.production
bootstrap/cache/*.php
storage/logs/*.log
!storage/logs/.gitkeep
storage/framework/cache/data/*
!storage/framework/cache/data/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
public/storage
