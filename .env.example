# Root-level variables consumed by docker-compose.yml itself.
# Copy to .env, then also copy backend/.env.example -> backend/.env
# and frontend/.env.example -> frontend/.env and fill those in too.
#
# NOTE ON "INFRASTRUCTURE SETTINGS CHANGEABLE WITHOUT REDEPLOYING":
# DB host/port and the API base URL that the ALREADY-RUNNING containers use
# at request time are read from the `settings` table (see backend
# app/Services/SettingsService.php + api/admin/settings endpoints), not from
# these files. These .env files only supply the values Docker needs to BOOT
# the containers the first time (container-to-container hostnames, initial
# DB credentials). Changing them still requires a restart; changing a row in
# `settings` via the admin UI does not.

APP_PORT=80
DB_FORWARD_PORT=3306

DB_DATABASE=koperasi
DB_USERNAME=koperasi
DB_PASSWORD=koperasi_secret
DB_ROOT_PASSWORD=root_secret

NEXT_PUBLIC_API_BASE_URL=/api
