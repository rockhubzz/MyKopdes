# Root-level variables consumed by docker-compose.yml itself.
#
# DON'T hand-copy this file — run the setup wizard instead:
#     bash scripts/setup.sh
# It asks for the database / backend / frontend connection secrets, generates
# strong values, and writes .env (+ frontend/.env). This file remains as
# documentation of which variables exist.
#
# NOTE: the database is auto-created and seeded on the FIRST boot of an empty
# Docker volume from ./mysql/init/01_koperasi_schema_seed.sql. To reset an
# existing database to that state later, run `bash scripts/db-reset.sh`.

APP_PORT=80

# Host-side MySQL exposure. Host empty = all interfaces; "127.0.0.1:" = only
# the host loopback (recommended; the containers always reach MySQL over the
# internal docker network regardless).
DB_FORWARD_HOST=127.0.0.1:
DB_FORWARD_PORT=3306

DB_DATABASE=koperasi
DB_USERNAME=koperasi
DB_PASSWORD=change_me_generated_by_setup_wizard
DB_ROOT_PASSWORD=change_me_generated_by_setup_wizard

# JWT signing key (HS256) used by the backend.
JWT_KEY=change_me_generated_by_setup_wizard
JWT_EXPIRY_MINUTES=1440
# Public site URL the users visit (JWT issuer/audience).
APP_URL=http://localhost

NEXT_PUBLIC_API_BASE_URL=/api
