# ============================================================================
# koperasi-app — root .gitignore
# Covers: backend-dotnet (ASP.NET) / frontend (Next.js) / nginx / db (MySQL)
# Rule: never commit secrets, dependencies, build output, or local data.
# Commit the *.example templates instead.
# ============================================================================

# --------------------------------------------------------------------------
# 0. Env / secrets — ALL scopes (never commit real credentials)
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
frontend/.env
frontend/.env*.local
!frontend/.env.example
*.pem
*.key
!**/*.key.example
.auth.json

# --------------------------------------------------------------------------
# 1. Backend (.NET 8) — build output is recreated by `dotnet publish` during
#    the Docker build; only source is versioned.
# --------------------------------------------------------------------------
backend-dotnet/bin/
backend-dotnet/obj/
backend-dotnet/publish/
backend-dotnet/backups/
backend-dotnet/.vs/
backend-dotnet/artifacts/

# --------------------------------------------------------------------------
# 2. Frontend — Next.js / Node
# --------------------------------------------------------------------------
# Dependencies (rebuilt from frontend/package-lock.json)
frontend/node_modules/
node_modules/
frontend/.pnp/
frontend/.pnp.js

# Build output
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
.next/
out/
build/
dist/

# Next.js / Vercel / Turbo caches
frontend/.vercel/
frontend/.turbo/
frontend/*.tsbuildinfo
frontend/.eslintcache
.tsbuildinfo
.eslintcache

# Debug / package-manager logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# Misc frontend runtime
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep

# --------------------------------------------------------------------------
# 3. Nginx — TLS certs / keys (see nginx/certs/README.md)
# --------------------------------------------------------------------------
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt
nginx/certs/*.csr
nginx/certs/*.p12
nginx/certs/*.pfx
nginx/certs/dhparam*.pem
nginx/*.htpasswd
nginx/.htpasswd
# Keep docs/placeholders so the folder structure survives clone
!nginx/certs/README.md
!nginx/certs/.gitkeep

# --------------------------------------------------------------------------
# 4. Database — MySQL data dirs, dumps & local volumes
# --------------------------------------------------------------------------
# Named docker volumes live outside the repo, but ignore any bind-mounted data
mysql_data/
mysql-data/
db_data/
db-data/
data/db/
data/mysql/
db/mysql-data/
database/data/
*.sql
*.sql.gz
*.dump
*.bak.sql
dump.rdb
*.sqlite
*.sqlite3
*.db
# The committed schema + demo seed IS the seeder — never ignore it.
!mysql/init/*.sql

# --------------------------------------------------------------------------
# 5. Docker / Compose local overrides
# --------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
.compose/
.docker/

# --------------------------------------------------------------------------
# 6. Logs, coverage, temp & backups (all scopes)
# --------------------------------------------------------------------------
*.log
logs/
log/
coverage/
.nyc_output/
.coverage/
htmlcov/
*.tmp
*.temp
*.swp
*.swo
*~
*.orig
*.rej
*.bak
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --------------------------------------------------------------------------
# 7. OS / editor / IDE noise
# --------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace
.sublime-project
.sublime-workspace
.project
.classpath
.settings/
*.iml
nbproject/
netbeans/
