# Production environment for docker-compose.prod.yml (consumed by ALL services).
#
#   cp .env.production.example .env.production
#   # 1. Fill in DB passwords + your domain below.
#   # 2. Build once so the backend image exists:
#   #      docker compose -f docker-compose.prod.yml --env-file .env.production build backend
#   # 3. Generate the Laravel app key and paste it into APP_KEY below:
#   #      docker compose -f docker-compose.prod.yml --env-file .env.production run --rm backend php artisan key:generate --show
#   # 4. Drop TLS certs into nginx/certs/ (see nginx/certs/README.md).
#   # 5. Boot: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# --- MySQL (also interpolated by the compose file itself) ---
DB_DATABASE=koperasi
DB_USERNAME=koperasi
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# --- Laravel backend ---
APP_NAME="Koperasi Store"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://koperasi.example.com
APP_KEY=
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=koperasi.example.com
SANCTUM_TOKEN_EXPIRATION_MINUTES=720
FRONTEND_URL=https://koperasi.example.com
CORS_ALLOWED_ORIGINS=https://koperasi.example.com

# Seeded into the settings table on first migrate+seed; afterwards the DB row wins.
DEFAULT_TAX_RATE=0
DEFAULT_SHU_RATE=0.02
LOW_STOCK_DEFAULT_THRESHOLD=10

BACKUP_DISK=local
BACKUP_SCHEDULE_CRON="0 2 * * *"

MAIL_MAILER=log

# --- Next.js frontend (BAKED INTO THE IMAGE AT BUILD TIME, not read at runtime) ---
# Must match APP_URL + /api, served by Nginx in front of the backend.
NEXT_PUBLIC_API_BASE_URL=https://koperasi.example.com/api
